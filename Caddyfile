floods.pk {
    # Compress responses for faster delivery
    encode gzip

    # Serve static assets directly from disk
    handle_path /static/* {
        root * /home/code4pk/mdrf/staticfiles
        file_server
    }

    # Serve user-uploaded media files directly from disk
    handle_path /media/* {
        root * /home/code4pk/mdrf/media
        file_server
    }

    # Route all other web traffic to Gunicorn
    handle {
        reverse_proxy 127.0.0.1:8000
    }
}
